<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/device_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/mediumYellow"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/darkGrey"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            android:layout_margin="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/darkGrey"
                android:orientation="vertical"
                android:layout_margin="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/nameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:text="@string/name_label"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:hint="@string/device_name_hint"
                        android:textColorHint="@color/mediumGrey"
                        android:textColor="@color/lightGrey"
                        app:layout_constraintStart_toEndOf="@id/nameTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/nameTextView"
                        app:layout_constraintBottom_toBottomOf="@id/nameTextView" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="3dp"
                    android:background="@color/mediumGrey" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/roomTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:text="@string/room_label"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/roomSpinner"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="10dp"
                        android:paddingEnd="35dp"
                        android:background="@drawable/spinner_main"
                        app:layout_constraintStart_toEndOf="@id/roomTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/roomTextView"
                        app:layout_constraintBottom_toBottomOf="@id/roomTextView"
                        tools:ignore="RtlSymmetry" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="3dp"
                    android:background="@color/mediumGrey" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/functionTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:text="@string/function_label"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/functionSpinner"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="10dp"
                        android:paddingEnd="35dp"
                        android:background="@drawable/spinner_main"
                        app:layout_constraintStart_toEndOf="@id/functionTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/functionTextView"
                        app:layout_constraintBottom_toBottomOf="@id/functionTextView"
                        tools:ignore="RtlSymmetry" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="3dp"
                    android:background="@color/mediumGrey" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ldrLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/ldrLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:text="@string/ldr_label"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/ldrThresholdLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:text="@string/ldr_threshold_label"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ldrLabelTextView"
                        />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ldrThresholdEditText"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:imeOptions="actionDone"
                        android:background="@color/lightGrey"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:textSize="16sp"
                        android:textColorHint="@color/mediumGrey"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toEndOf="@id/ldrThresholdLabelTextView"
                        app:layout_constraintTop_toTopOf="@id/ldrThresholdLabelTextView"
                        app:layout_constraintBottom_toBottomOf="@id/ldrThresholdLabelTextView" />

                    <TextView
                        android:id="@+id/ldrReadingLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:text="@string/ldr_reading_label"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ldrThresholdLabelTextView"
                        />

                    <TextView
                        android:id="@+id/ldrReadingValueTextView"
                        android:layout_height="wrap_content"
                        android:layout_width="100dp"
                        android:background="@color/lightGrey"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="@id/ldrThresholdEditText"
                        app:layout_constraintTop_toTopOf="@id/ldrReadingLabelTextView"
                        app:layout_constraintBottom_toBottomOf="@id/ldrReadingLabelTextView" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="15dp"
                        android:layout_height="3dp"
                        android:background="@color/mediumGrey"
                        app:layout_constraintTop_toBottomOf="@id/ldrReadingLabelTextView"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/firmwareTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:text="@string/firmware_label"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/currentFirmwareTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:singleLine="true"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/current_firmware_label"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/firmwareTextView" />

                    <TextView
                        android:id="@+id/latestFirmwareTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:text="@string/latest_firmware_label"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/currentFirmwareTextView" />

                    <TextView
                        android:id="@+id/currentVersionTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:textColor="@color/lightGrey"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@id/currentFirmwareTextView"
                        app:layout_constraintTop_toTopOf="@id/currentFirmwareTextView"
                        app:layout_constraintBottom_toBottomOf="@id/currentFirmwareTextView" />

                    <TextView
                        android:id="@+id/latestVersionTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:textColor="@color/lightGrey"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@id/latestFirmwareTextView"
                        app:layout_constraintTop_toTopOf="@id/latestFirmwareTextView"
                        app:layout_constraintBottom_toBottomOf="@id/latestFirmwareTextView" />

                    <TextView
                        android:id="@+id/firmwareStatusTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:singleLine="true"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/lightGrey"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/latestFirmwareTextView" />

                    <ImageButton
                        android:id="@+id/updateImageButton"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/button_update_states"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@string/firmware_update_description"
                        app:layout_constraintBottom_toBottomOf="@id/latestFirmwareTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/currentFirmwareTextView" />

                    <ProgressBar
                        android:id="@+id/loadingProgressBar"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="10dp"
                        android:visibility="invisible"
                        app:layout_constraintTop_toBottomOf="@+id/updateImageButton"
                        app:layout_constraintStart_toStartOf="@+id/updateImageButton"
                        app:layout_constraintEnd_toEndOf="@+id/updateImageButton" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="3dp"
                    android:background="@color/mediumGrey" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/yesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="10dp"
                        android:text="@string/confirm_button"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:enabled="false"
                        android:background="@drawable/button_text_states"
                        app:layout_constraintEnd_toStartOf="@id/noButton"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/noButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="10dp"
                        android:text="@string/cancel_button"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/button_text_normal"
                        app:layout_constraintStart_toEndOf="@id/yesButton"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>